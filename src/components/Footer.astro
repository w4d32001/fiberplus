---
const links = ["Inicio", "Nosotros", "Servicios", "Soporte", "Ubicación"];
const horario = [
    "Lunes a Viernes: 7:00 am – 10:00 pm",
    "Sábado: 9:00 am – 8:00 pm",
    "Domingo: 9:00 am – 7:00 pm",
];
---

<footer class="bg-brand-navy border-t border-white/10">
    <div class=" mx-auto px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="md:col-span-1">
                <div class="flex items-center gap-2 mb-4">
                    <div
                        class="w-10 h-10 bg-brand-red rounded-full flex items-center justify-center"
                    >
                        <span class="text-white font-display font-black text-xl"
                            >F</span
                        >
                    </div>
                    <span class="text-white font-display font-bold text-2xl"
                        >Fiber<span class="text-brand-red">plus</span></span
                    >
                </div>
                <p class="text-white/50 font-body text-sm leading-relaxed mb-5">
                    El internet 100% fibra óptica más rápido y confiable de
                    Abancay, Apurímac.
                </p>
                <div class="flex gap-3">
                    {
                        [
                            {
                                name: "Facebook",
                                href: "#",
                                path: "M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z",
                            },
                            {
                                name: "Instagram",
                                href: "#",
                                path: "M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01M7.5 2.5h9A5 5 0 0121.5 7.5v9a5 5 0 01-5 5h-9a5 5 0 01-5-5v-9a5 5 0 015-5z",
                            },
                            {
                                name: "TikTok",
                                href: "#",
                                path: "M9 12a4 4 0 104 4V4a5 5 0 005 5",
                            },
                        ].map((s) => (
                            <a
                                href={s.href}
                                aria-label={s.name}
                                class="w-9 h-9 rounded-full bg-white/10 hover:bg-brand-red flex items-center justify-center transition-colors duration-200"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="w-4 h-4 text-white"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={s.path}
                                    />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>
            <div>
                <p
                    class="font-display font-bold text-white uppercase tracking-widest text-sm mb-4"
                >
                    Menú
                </p>
                <ul class="space-y-2">
                    {
                        links.map((l) => (
                            <li>
                                <a
                                    href="#"
                                    class="text-white/50 hover:text-brand-red font-body text-sm transition-colors"
                                >
                                    {l}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <p
                    class="font-display font-bold text-white uppercase tracking-widest text-sm mb-4"
                >
                    Horario
                </p>
                <ul class="space-y-2">
                    {
                        horario.map((h) => (
                            <li class="text-white/50 font-body text-sm">{h}</li>
                        ))
                    }
                </ul>
            </div>
            <div>
                <p
                    class="font-display font-bold text-white uppercase tracking-widest text-sm mb-4"
                >
                    Contáctanos
                </p>
                <ul class="space-y-3">
                    <li class="flex items-start gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-brand-red mt-0.5 shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                            ></path>
                        </svg>
                        <span class="text-white/50 font-body text-sm"
                            >Jr. Arequipa 817, Abancay</span
                        >
                    </li>
                    <li class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-brand-red shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"
                            ></path>
                        </svg>
                        <div class="text-sm">
                            <a
                                href="tel:+51946759827"
                                class="block text-white/50 hover:text-brand-red font-body transition-colors"
                                >+51 946 759 827</a
                            >
                            <a
                                href="tel:+51959888104"
                                class="block text-white/50 hover:text-brand-red font-body transition-colors"
                                >+51 959 888 104</a
                            >
                        </div>
                    </li>
                    <li class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-4 h-4 text-brand-red shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                            ></path>
                        </svg>
                        <a
                            href="mailto:fiberplustel@gmail.com"
                            class="text-white/50 hover:text-brand-red font-body text-sm transition-colors"
                            >fiberplustel@gmail.com</a
                        >
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="border-t border-white/5 py-5">
        <p class="text-center text-white/30 font-body text-xs">
            © 2026 - 2026 FIBERPLUS. Todos los derechos reservados.
        </p>
    </div>
</footer>
<a
    href="https://wa.me/51946759827"
    target="_blank"
    aria-label="WhatsApp"
    class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#25D366] hover:bg-[#1ebe5c] rounded-full shadow-xl shadow-green-900/40 flex items-center justify-center transition-all duration-200 hover:scale-110"
>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-7 h-7 text-white"
        viewBox="0 0 24 24"
        fill="currentColor"
    >
        <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
        ></path>
    </svg>
</a>
