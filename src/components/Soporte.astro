---
import tecnico from "../assets/img/tecnico.png";

const faqs = [
  {
    pregunta: '¿Cómo puedo solicitar el servicio de FIBERPLUS?',
    respuesta: 'Puedes solicitar el servicio llamándonos al +51 946 759 827 o escribiéndonos por WhatsApp. También puedes visitarnos en nuestra oficina en Jr. Arequipa 817, Abancay.',
  },
  {
    pregunta: '¿Cuáles son los canales de atención de FIBERPLUS?',
    respuesta: 'Atendemos por llamadas (+51 946 759 827 / +51 959 888 104), WhatsApp, correo electrónico (fiberplustel@gmail.com) y presencialmente en nuestra oficina de Lunes a Sábado de 8:00 AM a 8:00 PM.',
  },
  {
    pregunta: '¿Cuáles son los medios de pago disponibles?',
    respuesta: 'Aceptamos pagos en efectivo, transferencias bancarias y pagos digitales. Puedes pagar en nuestra oficina o coordinar con nuestros técnicos.',
  },
  {
    pregunta: '¿El Mesh es un repetidor?',
    respuesta: 'No. El equipo Mesh es más avanzado que un repetidor. Crea una red wifi unificada de alta velocidad en todo tu hogar sin pérdida de señal, conectándose directamente a la red de fibra óptica.',
  },
];
---

<section id="ayuda" class="faq-section">
  <div class="faq-wrapper">

    <!-- HEADER CENTRADO -->
    <div class="faq-header">
      <p class="faq-badge">Soporte & FAQ</p>
      <h2 class="faq-title">
        ¿En qué podemos<br/>
        <span>ayudarte</span> hoy?
      </h2>
      <p class="faq-sub">
        Encuentra respuestas rápidas o contacta directamente con nuestro equipo de expertos técnicos.
      </p>
    </div>

    <!-- CONTENIDO: FAQs izq + imagen der -->
    <div class="faq-container">

      <!-- IZQUIERDA: FAQs -->
      <div class="faq-right">
        <div class="faq-list">
          {faqs.map((f, i) => (
            <div class="faq-item" data-index={i}>
              <button class="faq-trigger">
                <span class="faq-trigger-text">{f.pregunta}</span>
                <span class="faq-trigger-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </span>
              </button>
              <div class="faq-body">
                <p class="faq-respuesta">{f.respuesta}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- DERECHA: técnico con círculo (se oculta en mobile) -->
      <div class="faq-left">
        <div class="faq-circle-wrap">
          <div class="faq-circle"></div>
          <img src={tecnico.src} alt="Técnico FiberPlus" class="faq-tecnico-img"/>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.faq-section {
  background: #ffffff;
  padding: 2rem 0 4rem;
  position: relative;
  overflow: hidden;
}

.faq-wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ══ HEADER ══ */
.faq-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.faq-badge {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #00416b;
  margin: 0 0 12px;
}

.faq-title {
  font-size: clamp(2rem, 5vw, 3.8rem);
  font-weight: 900;
  color: #020812;
  line-height: 1.05;
  text-transform: uppercase;
  margin: 0 0 16px;
}

.faq-title span {
  color: #00416b;
}

.faq-sub {
  color: rgba(2,8,18,.5);
  font-size: 16px;
  line-height: 1.6;
  margin: 0 auto;
  max-width: 500px;
}

/* ══ GRID ══ */
.faq-container {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 60px;
  align-items: center;
}

@media (max-width: 768px) {
  .faq-container {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .faq-left {
    display: none !important;
  }
}

/* ══ DERECHA: imagen ══ */
.faq-left {
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.faq-circle-wrap {
  position: relative;
  width: 100%;
  max-width: 420px;
  height: 500px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.faq-circle {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: #020812;
  z-index: 0;
}

.faq-tecnico-img {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 420px;
  object-fit: contain;
  filter: drop-shadow(0 10px 40px rgba(0,65,107,.25));
}

/* ══ IZQUIERDA: FAQs ══ */
.faq-right {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.faq-item {
  background: #f5f8fb;
  border-radius: 16px;
  border: 1.5px solid rgba(0,65,107,.08);
  overflow: hidden;
  transition: border-color .2s, box-shadow .2s;
}

.faq-item.open {
  border-color: #00416b;
  background: #fff;
  box-shadow: 0 6px 24px rgba(0,65,107,.12);
}

.faq-trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px 22px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
}

.faq-trigger-text {
  font-size: 19px;
  font-weight: 700;
  color: #00416b;
  line-height: 1.4;
  flex: 1;
  transition: color .2s;
}

.faq-item.open .faq-trigger-text {
  color: #020812;
}

.faq-trigger-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #ed3237;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
  transition: transform .3s, background .2s;
}

.faq-item.open .faq-trigger-icon {
  transform: rotate(180deg);
  background: #00416b;
}

.faq-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height .4s cubic-bezier(.4,0,.2,1);
}

.faq-respuesta {
  padding: 12px 22px 22px;
  font-size: 16px;
  color: rgba(2,8,18,.6);
  line-height: 1.75;
  margin: 0;
  border-top: 1px solid rgba(0,65,107,.08);
}
</style>

<script is:inline>
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = item.querySelector('.faq-body');
      const isOpen = item.classList.contains('open');

      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-body').style.maxHeight = '0';
      });

      if (!isOpen) {
        item.classList.add('open');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });
</script>