---
const beneficios = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
      <rect x="8" y="28" width="48" height="28" rx="3" stroke="#e60000" stroke-width="3" fill="none"/>
      <rect x="16" y="36" width="10" height="8" rx="1" stroke="#e60000" stroke-width="2.5" fill="none"/>
      <rect x="32" y="36" width="16" height="3" rx="1" fill="#e60000"/>
      <rect x="32" y="43" width="10" height="3" rx="1" fill="#e60000"/>
      <path d="M20 28V20a12 12 0 0124 0v8" stroke="#e60000" stroke-width="3" stroke-linecap="round" fill="none"/>
      <circle cx="32" cy="12" r="3" fill="#e60000"/>
    </svg>`,
    titulo: '100% Fibra óptica',
    desc: 'Experimenta una conexión sin límites con el verdadero internet fibra óptica.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
      <rect x="6" y="14" width="38" height="28" rx="3" stroke="#e60000" stroke-width="3" fill="none"/>
      <line x1="6" y1="36" x2="44" y2="36" stroke="#e60000" stroke-width="2.5"/>
      <path d="M25 42v6M15 48h20" stroke="#e60000" stroke-width="3" stroke-linecap="round"/>
      <circle cx="50" cy="24" r="10" stroke="#e60000" stroke-width="3" fill="none"/>
      <path d="M46 24a4 4 0 018 0" stroke="#e60000" stroke-width="2" stroke-linecap="round"/>
      <circle cx="50" cy="24" r="2" fill="#e60000"/>
      <path d="M42 18l-6-4M42 30l-6 4" stroke="#e60000" stroke-width="2" stroke-linecap="round"/>
    </svg>`,
    titulo: '+Velocidad',
    desc: 'Somos el internet más rápido del Perú. Hasta 5000 Mbps de velocidad.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
      <circle cx="32" cy="32" r="22" stroke="#e60000" stroke-width="3" fill="none"/>
      <circle cx="32" cy="32" r="2.5" fill="#e60000"/>
      <line x1="32" y1="12" x2="32" y2="16" stroke="#e60000" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="32" y1="48" x2="32" y2="52" stroke="#e60000" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="12" y1="32" x2="16" y2="32" stroke="#e60000" stroke-width="2.5" stroke-linecap="round"/>
      <line x1="48" y1="32" x2="52" y2="32" stroke="#e60000" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M32 32L44 20" stroke="#e60000" stroke-width="2.5" stroke-linecap="round"/>
    </svg>`,
    titulo: '+Estabilidad',
    desc: 'Descarga, transmite y juega con el internet más estable de Latinoamérica.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
      <path d="M8 20 Q32 8 56 20" stroke="#e60000" stroke-width="3" stroke-linecap="round" fill="none"/>
      <path d="M14 30 Q32 20 50 30" stroke="#e60000" stroke-width="3" stroke-linecap="round" fill="none"/>
      <path d="M20 40 Q32 32 44 40" stroke="#e60000" stroke-width="3" stroke-linecap="round" fill="none"/>
      <rect x="28" y="46" width="8" height="8" rx="4" fill="#e60000"/>
    </svg>`,
    titulo: '+Conectividad',
    desc: 'Conéctate en más dispositivos sin perder calidad ni velocidad.',
  },
];
---
<section id="beneficios" class="py-12 md:py-16 bg-white">
  <div class="mx-auto px-6 sm:px-8 md:px-12 max-w-7xl">

    <div class="text-center mb-10 md:mb-14">
      <h2 class="font-display font-black text-[#020812] text-2xl sm:text-3xl md:text-4xl uppercase leading-tight">
        ¿Cuáles son los beneficios de<br/>
        <span class="text-[#00416b]">nuestros planes 100% fibra óptica?</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8 justify-items-center">
      {beneficios.map((b) => (
        <div class="flex flex-col items-center" style="padding-top: 28px;">

          <div class="relative flex items-center justify-center" style="overflow: visible;">

            <!-- ARCO SUPERIOR con SVG: extremos rectos y longitud controlada -->
            <svg
              viewBox="0 0 120 120"
              xmlns="http://www.w3.org/2000/svg"
              class="absolute pointer-events-none"
              style="width: 112%; height: 112%; top: -70%; left: -6%; z-index: 2; overflow: visible;"
            >
         
              <path
                d="M 17.6 82.4 A 55 55 0 0 1 102.4 82.4"
                fill="none"
                stroke="#1b2a4a"
                stroke-width="7"
                stroke-linecap="butt"
              />
            </svg>

            <!-- CÍRCULO PRINCIPAL -->
            <div class="w-42 h-42 sm:w-48 sm:h-48 md:w-52 md:h-52 lg:w-60 lg:h-60 xl:w-68 xl:h-68
                        rounded-full border-[5px] border-[#020812]
                        flex flex-col items-center justify-center
                        text-center px-4 gap-2 bg-white relative z-1">

              <!-- ICONO -->
              <div class="w-12 h-12 sm:w-12 sm:h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 xl:w-18 xl:h-18 [&>svg]:w-full [&>svg]:h-full">
                <Fragment set:html={b.icon} />
              </div>

              <!-- TITULO -->
              <h3 class="font-bold text-[11px] sm:text-xs md:text-sm lg:text-base xl:text-lg uppercase text-brand-dark leading-tight">
                {b.titulo}
              </h3>

              <!-- DESCRIPCIÓN -->
              <p class="text-[10px] sm:text-[11px] md:text-xs lg:text-base px-2 text-gray-600 leading-snug">
                {b.desc}
              </p>

            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>