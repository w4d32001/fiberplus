---
const horario = [
  { dia: 'Lunes a Viernes', horas: '7:00 am – 10:00 pm' },
  { dia: 'Sábado', horas: '9:00 am – 8:00 pm' },
  { dia: 'Domingo', horas: '9:00 am – 7:00 pm' },
];
---
<section id="ubicacion" class="bg-brand-light py-20">
  <div class="mx-auto px-8">
    <div class="text-center mb-12">
      <h2 class="font-display font-black text-brand-dark text-4xl md:text-5xl uppercase">
        Nos <span class="text-brand-red">encontramos</span> en...
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="space-y-6">
        <div class="flex gap-4 items-start bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
          </div>
          <div>
            <p class="font-display font-bold text-brand-dark text-sm uppercase tracking-wide mb-1">Ubicación</p>
            <p class="text-brand-dark/70 font-body">Jr. Arequipa 817, Abancay, Apurímac</p>
          </div>
        </div>
        <div class="flex gap-4 items-start bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
            </svg>
          </div>
          <div>
            <p class="font-display font-bold text-brand-dark text-sm uppercase tracking-wide mb-1">Teléfonos</p>
            <a href="tel:+51946759827" class="block text-brand-red font-body hover:underline">+51 946 759 827</a>
            <a href="tel:+51959888104" class="block text-brand-red font-body hover:underline">+51 959 888 104</a>
          </div>
        </div>
        <div class="flex gap-4 items-start bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="w-11 h-11 bg-brand-red/10 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
            </svg>
          </div>
          <div>
            <p class="font-display font-bold text-brand-dark text-sm uppercase tracking-wide mb-1">Correo</p>
            <a href="mailto:fiberplustel@gmail.com" class="text-brand-red font-body hover:underline">fiberplustel@gmail.com</a>
          </div>
        </div>
        <div class="bg-brand-navy rounded-2xl p-5">
          <div class="flex gap-3 items-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="font-display font-bold text-white text-sm uppercase tracking-wide">Horario de Atención</p>
          </div>
          {horario.map(h => (
            <div class="flex justify-between py-2 border-b border-white/10 last:border-0">
              <span class="text-white/60 font-body text-sm">{h.dia}</span>
              <span class="text-white font-body font-semibold text-sm">{h.horas}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-xl h-96 md:h-full min-h-80">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3800.7!2d-72.88!3d-13.63!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTPCsDM3JzQ4LjAiUyA3MsKwNTInNDguMCJX!5e0!3m2!1ses!2spe!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación Fiberplus Abancay"
        ></iframe>
      </div>
    </div>
  </div>
</section>
