---
import img1 from "../../assets/img/1.png";
import img2 from "../../assets/img/2.png";
import img3 from "../../assets/img/3.png";
import logo from "../../assets/img/fiber.png";
import fibra from "../../assets/img/fibra.png";

const bg1 = `url(${img1.src})`;
const bg2 = `url(${img2.src})`;
const bg3 = `url(${img3.src})`;
---

<section id="inicio" class="relative w-full min-h-screen overflow-hidden flex items-center justify-center lg:justify-end bg-slate-900">

  <div class="absolute inset-0 z-0">
    <div class="bg-slide bg-image-1"></div>
    <div class="bg-slide bg-image-2"></div>
    <div class="bg-slide bg-image-3"></div>
    <div class="absolute inset-0 bg-black/55"></div>
  </div>

  <div class="relative z-10 w-full max-w-sm mx-auto lg:mx-0 lg:mr-16 xl:mr-24 px-4 py-10 lg:py-0 flex flex-col gap-y-4">

    <div class="bg-white/95 backdrop-blur-sm px-6 py-8 md:px-8 md:py-10 rounded-2xl shadow-2xl">
      <span class="text-lg md:text-xl text-center block text-secondary font-bold mb-6">
        ¡Dejame tu numero para <br class="hidden sm:block"/> contactarnos!
      </span>
      <form action="" class="flex flex-col gap-y-4">
        <input
          type="text"
          placeholder="Ingrese su nombre"
          class="outline-none py-2.5 px-4 rounded-xl w-full border border-primary placeholder:text-gray-400 text-gray-600 text-sm focus:ring-2 focus:ring-secondary/30 transition"
        />
        <input
          type="text"
          placeholder="Ingrese su número"
          class="outline-none py-2.5 px-4 rounded-xl w-full border border-primary placeholder:text-gray-400 text-gray-600 text-sm focus:ring-2 focus:ring-secondary/30 transition"
        />
        <label class="flex items-start gap-x-2 cursor-pointer">
          <input type="checkbox" class="mt-0.5 accent-secondary shrink-0"/>
          <span class="text-xs text-gray-500 leading-relaxed">
            Autorizo el contacto para recibir información sobre WOW según los términos generales y condiciones.
          </span>
        </label>
        <button
          type="submit"
          class="w-full py-3 bg-secondary hover:bg-secondary/90 text-white rounded-xl cursor-pointer font-semibold transition-colors duration-200 text-sm"
        >
          Llámenme
        </button>
      </form>
    </div>
    <div class="bg-white/95 backdrop-blur-sm px-6 py-5 rounded-2xl shadow-2xl grid grid-cols-2 gap-x-4 items-center">
      <div class="relative flex items-center justify-center">
        <img src={logo.src} alt="Logo fiberplus" class="h-24 md:h-28 object-contain"/>
        <span class="py-2 px-3 bg-black rounded-full absolute -bottom-2 -left-1 text-white text-sm font-bold leading-none">TV</span>
      </div>
      <div class="flex flex-col items-center gap-y-2 text-center">
        <img src={fibra.src} alt="Fibra óptica" class="h-10 md:h-12 object-contain"/>
        <span class="text-gray-400 text-xs leading-snug">Conectate con el <br/> mejor plan</span>
        <button class="rounded-xl bg-secondary hover:bg-secondary/90 cursor-pointer text-white px-5 py-2 text-sm font-semibold transition-colors duration-200">
          Ver más
        </button>
      </div>
    </div>

  </div>
</section>

<style define:vars={{ bg1, bg2, bg3 }}>
  .bg-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    animation: fadeAnimation 18s infinite;
  }
  .bg-image-1 { background-image: var(--bg1); animation-delay: 0s; }
  .bg-image-2 { background-image: var(--bg2); animation-delay: 6s; }
  .bg-image-3 { background-image: var(--bg3); animation-delay: 12s; }

  @keyframes fadeAnimation {
    0%   { opacity: 0; }
    10%  { opacity: 1; }
    33%  { opacity: 1; }
    43%  { opacity: 0; }
    100% { opacity: 0; }
  }
</style>