---
import img1 from "../../assets/img/4.jpg";
import img2 from "../../assets/img/3.jpg";
import img1R from "../../assets/img/1R.jpg";
import img2R from "../../assets/img/4R.jpg";
import logo from "../../assets/img/fiber.png";
import fibra from "../../assets/img/fibra.png";

const bg1  = `url(${img1.src})`;
const bg2  = `url(${img2.src})`;
const bg1R = `url(${img1R.src})`;
const bg2R = `url(${img2R.src})`;
---

<section id="inicio" class="hero-section relative w-full bg-slate-900">

  <div class="absolute inset-0 z-0">
    <div class="bg-slide active" data-desktop={bg1} data-mobile={bg1R}></div>
    <div class="bg-slide"       data-desktop={bg2} data-mobile={bg2R}></div>
  </div>

<!-- DESKTOP: cards en columna a la derecha -->
<div class="absolute inset-0 z-10 hidden lg:flex flex-col items-end justify-center pr-10 xl:pr-16 2xl:pr-25 gap-y-2 xl:gap-y-6">
  <!-- Card 1: formulario de contacto -->
  <div class="w-64 xl:w-72 2xl:w-80 bg-white backdrop-blur-sm px-4 xl:px-5 2xl:px-4 py-4 xl:py-4 2xl:py-4 rounded-2xl card-3d border-t-6 border-secondary">
    <span class="text-sm xl:text-base 2xl:text-[22px] text-center block text-secondary font-bold mb-3 xl:mb-4 2xl:mb-6">
      ¡Dejame tu número para contactarnos!
    </span>
    <form action="" class="flex flex-col gap-y-2 xl:gap-y-3 2xl:gap-y-4">
      <input type="text" placeholder="Ingrese su nombre"
        class="outline-none py-2 xl:py-2.5 px-3 xl:px-4 rounded-xl w-full border border-primary placeholder:text-gray-500 text-gray-600 text-xs xl:text-sm focus:ring-2 focus:ring-secondary/30 transition"/>
      <input type="text" placeholder="Ingrese su número"
        class="outline-none py-2 xl:py-2.5 px-3 xl:px-4 rounded-xl w-full border border-primary placeholder:text-gray-500 text-gray-600 text-xs xl:text-sm focus:ring-2 focus:ring-secondary/30 transition"/>
      <label class="flex items-start gap-x-2 cursor-pointer">
        <input type="checkbox" class="mt-1 accent-secondary shrink-0"/>
        <span class="text-[10px] xl:text-xs text-gray-600 leading-relaxed">
          Autorizo el contacto para recibir información sobre Fiberplus según los términos generales y condiciones.
        </span>
      </label>
      <button type="submit"
        class="w-full py-2 xl:py-2.5 2xl:py-3 bg-secondary hover:bg-secondary/90 text-white rounded-xl cursor-pointer font-semibold transition-colors duration-200 text-sm xl:text-base 2xl:text-lg">
        Llámenme
      </button>
    </form>
  </div>

  <!-- Card 2 -->
  <div class="w-64 xl:w-72 2xl:w-60 bg-white backdrop-blur-sm px-4 xl:px-3 2xl:px-3 py-3 xl:py-4 2xl:py-3 rounded-2xl card-3d grid grid-cols-2 gap-x-3 xl:gap-x-2 items-center  border-t-6 border-secondary">
    <div class="relative flex items-center justify-center">
      <img src={logo.src} alt="Logo fiberplus" class="h-16 xl:h-16 2xl:h-21 object-contain"/>
      <span class="py-1 xl:py-2 px-2 xl:px-3 bg-black rounded-full absolute -bottom-2 -left-1 text-white text-[10px] xl:text-sm font-bold leading-none">TV</span>
    </div>
    <div class="flex flex-col items-center   text-center">
      <img src={fibra.src} alt="Fibra óptica" class="h-7 xl:h-9 2xl:h-9 object-contain"/>
      <span class="text-gray-700 text-sm xl:text-sm  leading-snug">Conectate con el mejor plan</span>
      <button 
      id="btn-ver-mas"
      onclick="const t = document.getElementById('servicios'); if(t){ window.scrollTo({ top: t.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' }); }"
      class="rounded-xl bg-secondary mt-2 hover:bg-secondary/90 cursor-pointer text-white px-3 xl:px-3 py-1 text-xs xl:text-sm font-semibold transition-colors duration-200">
      Ver más 
    </button>
    </div>
  </div>

</div>

  <!-- MOBILE: botón centrado abajo -->
  <div class="absolute inset-0 z-10 flex lg:hidden items-end justify-center pb-8">
    <button id="btn-contacto-mobile"
      class="relative bg-secondary text-white font-bold px-4 py-2 rounded-2xl shadow-2xl text-lg ripple-btn">
      ¡Contáctanos ahora!
    </button>
  </div>


  <div id="modal-contacto" class="fixed inset-0 z-50 bg-black/60 px-4" style="display:none;">
    <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl px-6 py-8 border-t-6 border-b-6 border-secondary/90">
      <div class="flex justify-between items-center mb-6">
        <span class="text-[22px] text-secondary font-bold text-center">¡Dejame tu numero para contactarnos!</span>
        <button id="btn-cerrar-modal" class="text-gray-400 hover:text-gray-600 text-3xl leading-none">&times;</button>
      </div>
      <form action="" class="flex flex-col gap-y-4">
        <input type="text" placeholder="Ingrese su nombre"
          class="outline-none py-2.5 px-4 rounded-xl w-full border border-primary placeholder:text-gray-400 text-gray-700 text-sm focus:ring-2 focus:ring-secondary/30 transition"/>
        <input type="text" placeholder="Ingrese su número"
          class="outline-none py-2.5 px-4 rounded-xl w-full border border-primary placeholder:text-gray-400 text-gray-700 text-sm focus:ring-2 focus:ring-secondary/30 transition"/>
        <label class="flex items-start gap-x-2 cursor-pointer">
          <input type="checkbox" class="mt-0.5 accent-secondary shrink-0"/>
          <span class="text-xs text-gray-600 leading-relaxed">
            Autorizo el contacto para recibir información sobre Fiberplus según los términos generales y condiciones.
          </span>
        </label>
        <button type="submit"
          class="w-full py-3 bg-secondary/90 hover:bg-secondary/90 text-white rounded-xl cursor-pointer font-semibold transition-colors duration-200 text-sm">
          Llámenme
        </button>
      </form>
    </div>
  </div>

</section>
<style>
 .ripple-btn::before,
  .ripple-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 5px solid var(--color-secondary);
    animation: ripple 1.5s ease-out infinite;
    z-index: -1;
  }
  .ripple-btn::after {
    animation-delay: 1s;
  }
  @keyframes ripple {
    0%   { opacity: 0.8; transform: scale(1); }
    100% { opacity: 0;   transform: scale(1.4); }
  }



  .hero-section {
    height: 0;
    padding-top: 120%; /* ratio exacto de tu imagen 1000x1200 */
  }

  @media (min-width: 1024px) {
    .hero-section {
      height: 0;
      padding-top: 37.01%;
    }
  }

  .bg-slide {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-size: 100% 100%;        /* ← estira exacto al contenedor que ya tiene el ratio correcto */
    background-position: top center;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }

  .bg-slide.active { opacity: 1; }

  @media (min-width: 1024px) {
    .bg-slide {
      background-size: cover;
      background-position: center center;
    }
  }

  @keyframes tvWipe {
    0%   { clip-path: inset(0 100% 0 0); }
    100% { clip-path: inset(0 0% 0 0); }
  }

  .bg-slide.wipe {
    animation: tvWipe 0.45s cubic-bezier(0.77, 0, 0.18, 1) forwards;
  }

  @keyframes modalIn {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  #modal-contacto > div {
    animation: modalIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
</style>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const slides   = document.querySelectorAll('.bg-slide');
    const btnOpen  = document.getElementById('btn-contacto-mobile');
    const modal    = document.getElementById('modal-contacto');
    const btnClose = document.getElementById('btn-cerrar-modal');
    let current = 0;
    let transitioning = false;

// Abrir
btnOpen.addEventListener('click', () => {
  modal.style.display        = 'flex';
  modal.style.alignItems     = 'center';
  modal.style.justifyContent = 'center';
  modal.style.opacity        = '0';
  modal.style.transition     = 'opacity 0.25s ease';
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      modal.style.opacity = '1';
    });
  });
});

// Cerrar con fade out
function closeModal() {
  modal.style.opacity    = '0';
  modal.style.transition = 'opacity 0.2s ease';
  setTimeout(() => { modal.style.display = 'none'; }, 200);
}

btnClose.addEventListener('click', closeModal);
modal.addEventListener('click', (e) => {
  if (e.target === modal) closeModal();
});

    function isMobile() {
      return window.innerWidth < 1024;
    }

    function updateImages() {
  slides.forEach(slide => {
    const img = isMobile()
      ? slide.getAttribute('data-mobile')
      : slide.getAttribute('data-desktop');
    
    console.log('width:', window.innerWidth, 'isMobile:', isMobile(), 'img:', img); // ← debug
    slide.style.backgroundImage = img;
  });
}

    updateImages();
    window.addEventListener('resize', updateImages);

    function nextSlide() {
      if (transitioning) return;
      transitioning = true;

      const prev = slides[current];
      current = (current + 1) % slides.length;
      const next = slides[current];

      next.style.opacity = '0';
      next.classList.remove('active', 'wipe');
      next.classList.add('active');

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          prev.style.transition = 'opacity 0.3s ease';
          prev.style.opacity = '0';
          next.style.opacity = '1';
          next.classList.add('wipe');

          setTimeout(() => {
            prev.classList.remove('active');
            prev.style.transition = '';
            prev.style.opacity = '';
            next.classList.remove('wipe');
            transitioning = false;
          }, 500);
        });
      });
    }

    setInterval(nextSlide, 5000);
  });
</script>