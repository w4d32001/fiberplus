---
const planes = [
    {
        nombre: "Básico",
        velocidad: 300,
        precio: 80,
        precioMesh: 120,
        destacado: false,
    },
    {
        nombre: "Especial",
        velocidad: 200,
        precio: 60,
        precioMesh: 100,
        destacado: true,
    },
    {
        nombre: "Pro",
        velocidad: 300,
        precio: 80,
        precioMesh: 120,
        destacado: false,
    },
    {
        nombre: "Ultra",
        velocidad: 500,
        precio: 110,
        precioMesh: 150,
        destacado: false,
    },
];
---

<section id="servicios" class="bg-brand-light py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div class="text-center mb-10 uppercase">
            <span class="block text-black/90 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display font-bold leading-tight">
                ¡Cero costo de instalación en todos
            </span>
            <h2 class="font-display text-secondary text-2xl sm:text-3xl md:text-4xl lg:text-5xl uppercase leading-none">
                Nuestros Planes
            </h2>
            <p class="text-black/90 text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-display font-bold">
                de Internet 100% Fibra Óptica!
            </p>
        </div>
        <div class="relative flex items-center gap-1 md:gap-2 py-8">
            <button
                id="prev"
                class="shrink-0 w-8 h-8 md:w-11 md:h-11 rounded-full border-2 border-brand-red bg-white text-brand-red text-base md:text-xl flex items-center justify-center hover:bg-brand-red hover:text-white transition-colors z-10 cursor-pointer shadow-md"
            >&#10094;</button>

            <div class="flex-1 overflow-hidden py-6">
                <div id="track" class="flex transition-transform duration-400 ease-in-out items-stretch">
                    {planes.map((p) => (
                        <div class={`flex-none rounded-2xl overflow-visible flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ${p.destacado ? "bg-brand-navy ring-2 ring-brand-red shadow-xl shadow-red-900/30 scale-105 z-10" : "bg-white shadow-md"}`}>
                            {p.destacado ? (
                                <div class="bg-brand-red text-white text-center text-xs font-display font-bold uppercase py-2 tracking-widest rounded-t-2xl">
                                    ⭐ Más Popular
                                </div>
                            ) : (
                                <div class="py-2 opacity-0 text-xs">placeholder</div>
                            )}

                            <div class="p-4 md:p-5 flex flex-col flex-1">
                                <p class={`text-xs uppercase tracking-widest mb-2 font-body ${p.destacado ? "text-white/50" : "text-brand-dark/40"}`}>
                                    Velocidad Contratada
                                </p>

                                <div class="flex items-end gap-1 mb-3">
                                    <span class={`font-display font-black text-4xl md:text-5xl lg:text-6xl leading-none ${p.destacado ? "text-white" : "text-brand-dark"}`}>
                                        {p.velocidad}
                                    </span>
                                    <div class="mb-1">
                                        <span class="font-display font-bold text-base md:text-lg text-brand-red">Mbps</span>
                                        <p class={`text-xs ${p.destacado ? "text-white/40" : "text-brand-dark/40"}`}>de velocidad</p>
                                    </div>
                                </div>

                                <hr class={`mb-3 ${p.destacado ? "border-white/10" : "border-gray-100"}`} />

                                <p class={`text-xs font-body mb-1 ${p.destacado ? "text-white/50" : "text-brand-dark/50"}`}>Internet</p>
                                <p class={`font-display font-black text-2xl md:text-3xl mb-3 ${p.destacado ? "text-white" : "text-brand-dark"}`}>
                                    S/ <span class="text-brand-red">{p.precio}</span>
                                    <span class={`text-xs md:text-sm font-body font-normal ${p.destacado ? "text-white/40" : "text-brand-dark/40"}`}>/mes</span>
                                </p>

                                <div class={`rounded-lg px-3 py-2 mb-4 flex items-center gap-2 ${p.destacado ? "bg-white/10" : "bg-brand-light"}`}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"/>
                                    </svg>
                                    <div>
                                        <p class={`text-xs ${p.destacado ? "text-white/50" : "text-brand-dark/50"}`}>Internet + Mesh</p>
                                        <p class={`font-display font-bold text-lg md:text-xl ${p.destacado ? "text-white" : "text-brand-dark"}`}>
                                            S/ <span class="text-brand-red">{p.precioMesh}</span>
                                        </p>
                                    </div>
                                </div>

                                <ul class="space-y-2 mb-5 flex-1">
                                    {["100% Fibra Óptica", "Internet ilimitado en todos los dispositivos"].map((f) => (
                                        <li class={`flex items-start gap-2 text-xs md:text-sm font-body ${p.destacado ? "text-white/80" : "text-brand-dark/70"}`}>
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-red shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                            </svg>
                                            {f}
                                        </li>
                                    ))}
                                </ul>

                                <a href="https://wa.me/51946759827" target="_blank"
                                    class={`block text-center font-display font-bold text-sm md:text-base py-2.5 md:py-3 rounded-xl mb-2 transition-all duration-200 bg-brand-red hover:bg-red-700 text-white ${p.destacado ? "shadow-lg shadow-red-900/40" : ""}`}>
                                    ¡INSTALACIÓN GRATIS!
                                </a>
                                <a href="#"
                                    class={`block text-center font-body text-xs md:text-sm py-2 rounded-xl border transition-colors duration-200 ${p.destacado ? "border-white/20 text-white/60 hover:text-white hover:border-white/40" : "border-gray-200 text-brand-dark/50 hover:text-brand-dark"}`}>
                                    Quiero este plan
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <button
                id="next"
                class="shrink-0 w-8 h-8 md:w-11 md:h-11 rounded-full border-2 border-brand-red bg-white text-brand-red text-base md:text-xl flex items-center justify-center hover:bg-brand-red hover:text-white transition-colors z-10 cursor-pointer shadow-md"
            >&#10095;</button>
        </div>

        <div id="dots" class="flex justify-center gap-2 mb-8"></div>

        <div class="flex items-center justify-between gap-2">
            <div class="hidden md:flex items-center gap-3 lg:gap-6 shrink-0">
                <div class="w-8 h-8 lg:w-10 lg:h-10 rounded-full bg-primary"></div>
                <div class="w-14 h-14 lg:w-20 lg:h-20 rounded-full bg-primary"></div>
                <div class="w-20 h-20 lg:w-28 lg:h-28 rounded-full bg-primary"></div>
            </div>
            <div class="flex-1 bg-brand-red rounded-2xl p-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
                <div>
                    <p class="font-display font-bold text-white text-base md:text-lg lg:text-xl">
                        Alquiler mensual del equipo Mesh
                    </p>
                    <p class="text-white/70 font-body text-xs md:text-sm mt-1">
                        Amplía la cobertura wifi en toda tu casa
                    </p>
                </div>
                <div class="w-full sm:w-auto shrink-0 flex flex-col gap-1.5 rounded-xl bg-white p-3 md:p-4">
                    <p class="font-display text-brand-red font-bold text-sm md:text-base">
                        ► S/5 para nuevos clientes
                    </p>
                    <p class="font-display text-brand-red font-bold text-sm md:text-base">
                        ► S/1 si migrás desde otro operador
                    </p>
                </div>
            </div>

            <div class="hidden md:flex items-center gap-3 lg:gap-6 shrink-0">
                <div class="w-20 h-20 lg:w-28 lg:h-28 rounded-full bg-primary"></div>
                <div class="w-14 h-14 lg:w-20 lg:h-20 rounded-full bg-primary"></div>
                <div class="w-8 h-8 lg:w-10 lg:h-10 rounded-full bg-primary"></div>
            </div>

        </div>

    </div>
</section>

<script>
    const track = document.getElementById("track") as HTMLElement;
    const cards = track.querySelectorAll<HTMLElement>(":scope > div");
    const dotsContainer = document.getElementById("dots") as HTMLElement;
    let current = 0;
    let autoplay: ReturnType<typeof setInterval>;

    function getVisible(): number {
        if (window.innerWidth < 480) return 1;
        if (window.innerWidth < 768) return 2;
        return 4;
    }

    function maxIndex(): number {
        return Math.max(0, cards.length - getVisible());
    }

    function updateTrack(): void {
        const vis = getVisible();
        const trackWidth = track.parentElement!.clientWidth;
        const gap = 12;
        const cardWidth = (trackWidth - gap * (vis - 1)) / vis;

        cards.forEach((c, i) => {
            c.style.width = `${cardWidth}px`;
            c.style.marginRight = i < cards.length - 1 ? `${gap}px` : "0px";
        });

        track.style.transform = `translateX(-${current * (cardWidth + gap)}px)`;

        dotsContainer.querySelectorAll(".dot").forEach((d, i) => {
            d.classList.toggle("bg-brand-red", i === current);
            d.classList.toggle("scale-125", i === current);
            d.classList.toggle("bg-black/20", i !== current);
        });
    }

    function buildDots(): void {
        dotsContainer.innerHTML = "";
        const count = maxIndex() + 1;
        if (count <= 1) return;
        for (let i = 0; i < count; i++) {
            const d = document.createElement("button");
            d.className = `dot w-2.5 h-2.5 rounded-full border-none cursor-pointer transition-all duration-200 ${i === current ? "bg-brand-red scale-125" : "bg-black/20"}`;
            d.addEventListener("click", () => { current = i; updateTrack(); buildDots(); });
            dotsContainer.appendChild(d);
        }
    }

    function startAutoplay() {
        autoplay = setInterval(() => {
            current = current >= maxIndex() ? 0 : current + 1;
            updateTrack(); buildDots();
        }, 3500);
    }

    document.getElementById("prev")!.addEventListener("click", () => {
        current = current <= 0 ? maxIndex() : current - 1;
        updateTrack(); buildDots();
    });

    document.getElementById("next")!.addEventListener("click", () => {
        current = current >= maxIndex() ? 0 : current + 1;
        updateTrack(); buildDots();
    });

    track.addEventListener("mouseenter", () => clearInterval(autoplay));
    track.addEventListener("mouseleave", () => startAutoplay());

    window.addEventListener("resize", () => {
        current = 0; buildDots(); updateTrack();
    });

    buildDots();
    updateTrack();
    startAutoplay();
</script>