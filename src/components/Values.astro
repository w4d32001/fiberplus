---
import check from "../assets/img/check.png";
---
<!-- ── SECCIÓN: Características principales ── -->
<section class="relative py-2 sm:py-7 overflow-hidden bg-white">

  <!-- DESKTOP: 4 tarjetas en fila -->
  <div class="relative hidden md:grid grid-cols-4 gap-6 lg:gap-10 
            max-w-5xl lg:max-w-7xl mx-auto px-8 
            justify-center items-center" style="z-index: 1;">

    <!-- 100% Fibra Óptica -->
    <div class="flex items-center gap-3">
      <img src={check.src} alt="check" class="w-10 h-10 lg:w-14 lg:h-14 flex-shrink-0" />
      <div class="flex items-center gap-2 rounded-2xl px-4 py-3 lg:px-5 border-2 flex-1" style="border-color: #083969;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 lg:w-9 lg:h-9 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" style="color: #083969;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12c0 0 2-4 5-4s4 4 7 4 4-4 6-4"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16c0 0 2-4 5-4s4 4 7 4 3.5-2.5 5-3.5"/>
          <circle cx="19" cy="8" r="1.5" fill="currentColor" stroke="none"/>
          <circle cx="19" cy="12" r="1" fill="currentColor" stroke="none" opacity="0.7"/>
          <path stroke-linecap="round" d="M20.5 5.5 L22 4"/>
          <path stroke-linecap="round" d="M21 8 L23 8"/>
          <path stroke-linecap="round" d="M20.5 10.5 L22 12"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M2 12 C2 8.5 4.5 5 8 4.5"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 19 L5 17 C5 15.5 6.5 14 8 14 L10 14"/>
          <rect x="2" y="17" width="6" height="4" rx="1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div>
          <p class="text-xs leading-none opacity-70" style="color: #083969;">Conexión de</p>
          <p class="text-sm lg:text-[18px] font-extrabold leading-tight" style="color: #083969;">100% Fibra</p>
        </div>
      </div>
    </div>

    <!-- Velocidad Garantizada -->
    <div class="flex items-center gap-3">
      <img src={check.src} alt="check" class="w-10 h-10 lg:w-14 lg:h-14 flex-shrink-0" />
      <div class="flex items-center gap-2 rounded-2xl px-4 py-2 lg:px-5 border-2 flex-1" style="border-color: #083969;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 lg:w-10 lg:h-10 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" style="color: #083969;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 14 A6 6 0 0 1 6.27 10"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 14 A6 6 0 0 0 17.73 10"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.5 16.5 A8 8 0 0 1 4 12 A8 8 0 0 1 20 12 A8 8 0 0 1 18.5 16.5"/>
          <path stroke-linecap="round" stroke-width="2" d="M12 14 L15.5 8.5"/>
          <circle cx="12" cy="14" r="1.2" fill="currentColor" stroke="none"/>
          <path stroke-linecap="round" d="M4.5 12 L5.8 12"/>
          <path stroke-linecap="round" d="M19.5 12 L18.2 12"/>
          <path stroke-linecap="round" d="M12 4.5 L12 5.8"/>
          <path stroke-linecap="round" d="M7.2 6.2 L8.1 7.1"/>
          <path stroke-linecap="round" d="M16.8 6.2 L15.9 7.1"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19 L15 19"/>
        </svg>
        <div>
          <p class="text-xs leading-none opacity-70" style="color: #083969;">Siempre con</p>
          <p class="text-sm lg:text-[18px] font-extrabold leading-tight" style="color: #083969;">Velocidad</p>
        </div>
      </div>
    </div>

    <!-- Estabilidad de Conexión -->
    <div class="flex items-center gap-3">
      <img src={check.src} alt="check" class="w-10 h-10 lg:w-14 lg:h-14 flex-shrink-0" />
      <div class="flex items-center gap-2 rounded-2xl px-4 py-3 lg:px-5 border-2 flex-1" style="border-color: #083969;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 lg:w-9 lg:h-9 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" style="color: #083969;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M1.5 8.5 C5.2 4.8 10.2 2.5 12 2.5 S18.8 4.8 22.5 8.5"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 11.5 C6.8 9.2 9.3 8 12 8 S17.2 9.2 19.5 11.5"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.8 14.5 C9 13.3 10.4 12.5 12 12.5 S15 13.3 16.2 14.5"/>
          <circle cx="12" cy="18" r="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 18 L11.8 19 L13.5 17"/>
        </svg>
        <div>
          <p class="text-xs leading-none opacity-70" style="color: #083969;">Garantiza conexión</p>
          <p class="text-sm lg:text-[18px] font-extrabold leading-tight" style="color: #083969;">Estable</p>
        </div>
      </div>
    </div>

    <!-- Beneficios Exclusivos -->
    <div class="flex items-center gap-3">
      <img src={check.src} alt="check" class="w-10 h-10 lg:w-14 lg:h-14 flex-shrink-0" />
      <div class="flex items-center gap-2 rounded-2xl px-4 py-3 lg:px-5 border-2 flex-1" style="border-color: #083969;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 lg:w-9 lg:h-9 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4" style="color: #083969;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 3 L16 3 L16 10 C16 14 12 16 12 16 C12 16 8 14 8 10 Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 5 C6 5 4 6.5 4 8.5 C4 10.5 6 11.5 8 11"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 5 C18 5 20 6.5 20 8.5 C20 10.5 18 11.5 16 11"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 16 L12 19"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19 L15 19"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 22 L15 22"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 7 L12.6 8.8 L14.5 8.8 L13 9.9 L13.5 11.7 L12 10.6 L10.5 11.7 L11 9.9 L9.5 8.8 L11.4 8.8 Z"/>
        </svg>
        <div>
          <p class="text-xs leading-none opacity-70" style="color: #083969;">Disfruta de Beneficios</p>
          <p class="text-sm lg:text-[18px] font-extrabold leading-tight" style="color: #083969;">Exclusivos</p>
        </div>
      </div>
    </div>

  </div>


  <!-- MOBILE: carrusel automático -->
  <div class="relative flex md:hidden overflow-hidden w-full" style="z-index: 1;">
    <div id="features-track" class="flex gap-3 px-2">
      {[
        {
          sub: "Conexión de", bold: "100% Fibra Óptica",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12c0 0 2-4 5-4s4 4 7 4 4-4 6-4"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16c0 0 2-4 5-4s4 4 7 4 3.5-2.5 5-3.5"/>
            <circle cx="19" cy="8" r="1.5" fill="currentColor" stroke="none"/>
            <path stroke-linecap="round" d="M20.5 5.5 L22 4"/>
            <path stroke-linecap="round" d="M21 8 L23 8"/>
            <path stroke-linecap="round" d="M20.5 10.5 L22 12"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 19 L5 17 C5 15.5 6.5 14 8 14 L10 14"/>
            <rect x="2" y="17" width="6" height="4" rx="1" stroke-linecap="round" stroke-linejoin="round"/>`
        },
        {
          sub: "Siempre con", bold: "Velocidad Garantizada",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14 A6 6 0 0 1 6.27 10"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14 A6 6 0 0 0 17.73 10"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.5 16.5 A8 8 0 0 1 4 12 A8 8 0 0 1 20 12 A8 8 0 0 1 18.5 16.5"/>
            <path stroke-linecap="round" stroke-width="2" d="M12 14 L15.5 8.5"/>
            <circle cx="12" cy="14" r="1.2" fill="currentColor" stroke="none"/>
            <path stroke-linecap="round" d="M4.5 12 L5.8 12"/>
            <path stroke-linecap="round" d="M19.5 12 L18.2 12"/>
            <path stroke-linecap="round" d="M12 4.5 L12 5.8"/>
            <path stroke-linecap="round" d="M7.2 6.2 L8.1 7.1"/>
            <path stroke-linecap="round" d="M16.8 6.2 L15.9 7.1"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19 L15 19"/>`
        },
        {
          sub: "Máxima", bold: "Estabilidad de Conexión",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M1.5 8.5 C5.2 4.8 10.2 2.5 12 2.5 S18.8 4.8 22.5 8.5"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 11.5 C6.8 9.2 9.3 8 12 8 S17.2 9.2 19.5 11.5"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.8 14.5 C9 13.3 10.4 12.5 12 12.5 S15 13.3 16.2 14.5"/>
            <circle cx="12" cy="18" r="2.2"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 18 L11.8 19 L13.5 17"/>`
        },
        {
          sub: "Disfruta de", bold: "Beneficios Exclusivos",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 3 L16 3 L16 10 C16 14 12 16 12 16 C12 16 8 14 8 10 Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5 C6 5 4 6.5 4 8.5 C4 10.5 6 11.5 8 11"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 5 C18 5 20 6.5 20 8.5 C20 10.5 18 11.5 16 11"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16 L12 19"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19 L15 19"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 22 L15 22"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 7 L12.6 8.8 L14.5 8.8 L13 9.9 L13.5 11.7 L12 10.6 L10.5 11.7 L11 9.9 L9.5 8.8 L11.4 8.8 Z"/>`
        },
        // duplicados para el loop infinito
        {
          sub: "Conexión de", bold: "100% Fibra Óptica",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12c0 0 2-4 5-4s4 4 7 4 4-4 6-4"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16c0 0 2-4 5-4s4 4 7 4 3.5-2.5 5-3.5"/>
            <circle cx="19" cy="8" r="1.5" fill="currentColor" stroke="none"/>
            <path stroke-linecap="round" d="M20.5 5.5 L22 4"/>
            <path stroke-linecap="round" d="M21 8 L23 8"/>
            <path stroke-linecap="round" d="M20.5 10.5 L22 12"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 19 L5 17 C5 15.5 6.5 14 8 14 L10 14"/>
            <rect x="2" y="17" width="6" height="4" rx="1" stroke-linecap="round" stroke-linejoin="round"/>`
        },
        {
          sub: "Siempre con", bold: "Velocidad Garantizada",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14 A6 6 0 0 1 6.27 10"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14 A6 6 0 0 0 17.73 10"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.5 16.5 A8 8 0 0 1 4 12 A8 8 0 0 1 20 12 A8 8 0 0 1 18.5 16.5"/>
            <path stroke-linecap="round" stroke-width="2" d="M12 14 L15.5 8.5"/>
            <circle cx="12" cy="14" r="1.2" fill="currentColor" stroke="none"/>
            <path stroke-linecap="round" d="M4.5 12 L5.8 12"/>
            <path stroke-linecap="round" d="M19.5 12 L18.2 12"/>
            <path stroke-linecap="round" d="M12 4.5 L12 5.8"/>
            <path stroke-linecap="round" d="M7.2 6.2 L8.1 7.1"/>
            <path stroke-linecap="round" d="M16.8 6.2 L15.9 7.1"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19 L15 19"/>`
        },
        {
          sub: "Máxima", bold: "Estabilidad de Conexión",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M1.5 8.5 C5.2 4.8 10.2 2.5 12 2.5 S18.8 4.8 22.5 8.5"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 11.5 C6.8 9.2 9.3 8 12 8 S17.2 9.2 19.5 11.5"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.8 14.5 C9 13.3 10.4 12.5 12 12.5 S15 13.3 16.2 14.5"/>
            <circle cx="12" cy="18" r="2.2"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 18 L11.8 19 L13.5 17"/>`
        },
        {
          sub: "Disfruta de", bold: "Beneficios Exclusivos",
          icon: `
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 3 L16 3 L16 10 C16 14 12 16 12 16 C12 16 8 14 8 10 Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5 C6 5 4 6.5 4 8.5 C4 10.5 6 11.5 8 11"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 5 C18 5 20 6.5 20 8.5 C20 10.5 18 11.5 16 11"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16 L12 19"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19 L15 19"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 22 L15 22"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 7 L12.6 8.8 L14.5 8.8 L13 9.9 L13.5 11.7 L12 10.6 L10.5 11.7 L11 9.9 L9.5 8.8 L11.4 8.8 Z"/>`
        },
      ].map(({ sub, bold, icon }) => (
        <div class="flex-shrink-0 flex items-center gap-2">
          <!-- Check imagen separada mobile -->
          <img src={check.src} alt="check" class="w-9 h-9 flex-shrink-0" />
          <!-- Tarjeta mobile -->
          <div class="flex items-center gap-2 rounded-xl px-3 py-2 border" style="border-color: #083969;">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: #083969;" set:html={icon} />
            <div>
              <p class="leading-none opacity-70" style="font-size:10px; color: #083969;">{sub}</p>
              <p class="font-extrabold leading-tight" style="font-size:11px; color: #083969;">{bold}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

</section>

<script is:inline>
  const featTrack = document.getElementById('features-track');
  if (featTrack) {
    let pos = 0;
    (function animateFeatures() {
      pos -= 0.5;
      if (Math.abs(pos) >= featTrack.scrollWidth / 2) pos = 0;
      featTrack.style.transform = `translateX(${pos}px)`;
      requestAnimationFrame(animateFeatures);
    })();
  }
</script>