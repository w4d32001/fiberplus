<header class="sticky top-0 z-50 bg-brand-navy shadow-lg">
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2">
      <div class="w-10 h-10 bg-brand-red rounded-full flex items-center justify-center">
        <span class="text-white font-display font-black text-xl leading-none">F</span>
      </div>
      <span class="text-white font-display font-bold text-2xl tracking-wide">Fiber<span class="text-brand-red">plus</span></span>
    </a>

    <!-- Nav links -->
    <nav class="hidden md:flex items-center gap-8">
      {['Inicio','Nosotros','Servicios','Soporte','Ubicación'].map(link => (
        <a href="#" class="text-white/80 hover:text-brand-red font-body font-semibold text-sm transition-colors duration-200">{link}</a>
      ))}
    </nav>

    <!-- CTA -->
    <a href="tel:+51946759827" class="hidden md:inline-flex items-center gap-2 bg-brand-red hover:bg-red-700 text-white font-display font-bold text-base px-5 py-2 rounded-full transition-colors duration-200">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 8V5z"/>
      </svg>
      946 759 827
    </a>

    <!-- Hamburger -->
    <button class="md:hidden text-white p-2" aria-label="Menú">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
</header>
